FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS build
WORKDIR /src

COPY go.mod go.sum* ./
RUN --mount=type=cache,id=statesight-go-mod-v1,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,id=statesight-go-mod-v1,target=/go/pkg/mod \
    --mount=type=cache,id=statesight-go-build-v1,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/api ./apps/api

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
WORKDIR /app
COPY --from=build /out/api /app/api
EXPOSE 8080
ENTRYPOINT ["/app/api"]
