FROM golang:1.25.10-alpine@sha256:8d22e29d960bc50cd025d93d5b7c7d220b1ee9aa7a239b3c8f55a57e987e8d45 AS build
WORKDIR /src

COPY go.mod go.sum* ./
RUN --mount=type=cache,id=statesight-go-mod-v1,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,id=statesight-go-mod-v1,target=/go/pkg/mod \
    --mount=type=cache,id=statesight-go-build-v1,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/api ./apps/api

FROM gcr.io/distroless/static-debian12:nonroot@sha256:d093aa3e30dbadd3efe1310db061a14da60299baff8450a17fe0ccc514a16639
WORKDIR /app
COPY --from=build /out/api /app/api
EXPOSE 8080
ENTRYPOINT ["/app/api"]
