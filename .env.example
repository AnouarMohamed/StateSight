# StateSight baseline environment

API_PORT=8080
WEB_PORT=5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/statesight?sslmode=disable
REDIS_URL=redis://localhost:6379/0
GITHUB_WEBHOOK_SECRET=replace-me
LOG_LEVEL=info
GIT_BIN=git
GIT_CACHE_DIR=.statesight/git-cache
KUBECTL_BIN=kubectl
ALLOW_SYNTHETIC_LIVE_STATE=false
AUTH_REQUIRED=false
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_ALLOW_INSECURE_ISSUER=false
